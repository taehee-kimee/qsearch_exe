<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- 진입점을 Program.cs의 Main으로 지정 -->
    <StartupObject>QuizHelper.Program</StartupObject>
    <!-- Single source of truth for the app version.
         scripts/build_release.ps1 reads this, and the UI badge shows it at runtime. -->
    <Version>2.0.6</Version>
    <!-- AI판(그깽족보 AI)의 버전. scripts/build_release_ai.ps1 이 읽는다. -->
    <AiVersion>1.0.0</AiVersion>
  </PropertyGroup>

  <!-- AI판: dotnet publish -p:Edition=AI
       같은 소스에서 AI 코드(#if AI_EDITION)만 더 들어간 별도 앱. 일반판 빌드에는 아무 영향이 없다. -->
  <PropertyGroup Condition="'$(Edition)'=='AI'">
    <DefineConstants>$(DefineConstants);AI_EDITION</DefineConstants>
    <Version>$(AiVersion)</Version>
    <Product>그깽족보 AI</Product>
  </PropertyGroup>

  <!-- Release 빌드 최적화 설정 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Tiered Compilation: 빠른 시작과 최적화된 성능 -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <!-- 런타임 최적화 -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1005" />
  </ItemGroup>

  <ItemGroup>
    <None Update="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\collected_page.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
